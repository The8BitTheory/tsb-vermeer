#RetroDevStudio.MetaData.BASIC:2049,Tuned Simons' BASIC,lowercase,10,10
# NY=1: LOADED VIA 
#       CLEAR UNUSED BASIC AREA, RESET PROC STACK POINTER, DO CHECK AND SAVE TO REU
# NY=2: LOADED VIA 
#       RESTORE PROCEDURE TABLE AND POINTER
5 IF NY=1 THEN GOSUB 60300:POKE $C530,0:CHECK:NY=NY+1:NYCHKSAV:GOTO 10
6 IF NY=2 THEN GOSUB 60105

# CLEAR TSB CALL STACK
10 POKE $C62C,0

20 IF LV=1 THEN CALL OTOM
30 IF LV=2 THEN CALL AUCTION
40 END


# 8299 PROC AUCTION
# OR AUCTIONS, PLAYERS SHOULD HAVE THEIR CASH AND BANK AMOUNT AVAILABLE
# OR AUCTIONS IN EW ORK, PLAYERS MUST HAVE OLLARS IN THEIR ACCOUNT.
# UCTION OVERVIEW SHOULD ALSO SHOW THE CALLING PRICE AND WHAT THE PLAYER HAS
# AVAILABLE.
# UCTIONS START AUTOMATICALLY WHEN THE DATE HAS COME, BEFORE ANY PLAYER GETS
# TO THEIR TURN.
# EFORE THE AUCTION STARTS, PLAYERS CAN CHOSE TO OPT-IN OR OUT.
# F NO PLAYER PARTICIPATES, THE AUCTION ACTION SEQUENCE IS SKIPPED

80 PROC AUCTION

#   FETCH THE SPRITES THAT WE NEED

#   FETCH AUCTION ML-ROUTINES
#85  SYS $CA00,1

90  BC=XM(2)+80:AK=$CA03


#    FRAME FOR AUCTIONEERS
100  MOB SET 5,1,1,0,0,3:MOB SET 6,3,1,0,0,3:SETBC

#    AUCTION HEADER
110  FSB:FR=32:SYSFM,FR

#    AUCTION FAME (THE BIG ONE)
120  FR=31:SYSFM,FR:FRS

#     DRAW MAX BID BAR
#8330  PRINT AT(BY+1,BX+14) DUP("",15);
130

#    PRINT PLAYER NAMES
140  FORX=0TO3
150   PRINT AT(BY+2+4*X,BX+1)PN$(X);
160  NEXT

#    DRAW INITIAL SPRITES AND SET PLAYERBIDS TO ZERO
170  FORX=1TO3
180   MMOB X,XM(2)+88,YM(2)+7+32*X
190   MOB SET X,12,1,0,0,0
#     PLAYER BIDS
200   PB%(X-1)=0
210  NEXT


#    HIGHEST BIDDER (BOTTOM FRAME)
220  FR=33:SYSFM,FR:FRS

230  PRINT AT(0,38) "A";

#240  CX=10:CY=0:TX=75:CPX

# SA:AUCTION TIMER. SHOULD VARY SPEED
# SV:TIMER SPEED. 30 JIFFIES PER DEFAULT
# CD:COUNTDOWN. HOW MANY LINES THE TIMER BAR HAS
260  SA=TI:CD=15:SV=30

#    DRAW COUNTDOWN VISUALIZATION
270  FCHR 5,37,1,15,95:FCOL 5,37,1,15,1

# THE WAY AUCTIONING WORKS
#  THE TOTAL TIME LIMIT IS 5 SECONDS AND THAT IS NEVER EXTENDED OR RESTORED.
#  PLAYERS PRESS A KEY TO BID
#  TIME IS CONSTANTLY RUNNING, EXCEPT A CHANGE TO THE HIGHEST BID IS MADE
#  SO, IF BIDS ARE INCREASING, TIME STANDS STILL
#  AS SOON AS NO BIDDING PROCESS IS MADE, THE CLOCK CONTINUES TO TICK
#

280 HO=50000
285 PRINT AT(22,11) HO" ";
290 AA(0)=-1:AA(1)=-1:AA(2)=-1

300 POKE198,0

# $CA00,1 COPIES AUCTION.BIN FROM REU TO RAM AND EXECUTES IT (IE READ KEYS)
301 SYS MM+$1E,1:I=PEEK(AK):IF I<>7 THEN 301

# AIN=AUCTION INPUT
310 PROC AIN
#    $CA00 JUST EXECUTES AUCTION.BIN WITHOUT THE COPY BEFORE
320  SYS $CA00:I=PEEK(AK)

350  IF TI-SA<SV THEN CALL AIN
360  SA=TI:BC=BC+3:IF BC>260 THEN BC=XM(2)+80
365  SETBC

370  IF (IAND1)=1 AND AA(0) THEN PB=0:MOGUY:ELSE AA(0)=0:MOB SET 1,14,1,0,0
380  IF (IAND2)=2 AND AA(1) THEN PB=1:MOGUY:ELSE AA(1)=0:MOB SET 2,14,1,0,0
390  IF (IAND4)=4 AND AA(2) THEN PB=2:MOGUY:ELSE AA(2)=0:MOB SET 3,14,1,0,0

400  AA=0:FORX=0TO2:IF AA(X) THEN AA=AA+1
410  NEXT:IFAA>1 THEN HO=HO+1000:PRINT AT(22,11) HO" ";:CALL AIN

420  IF AA=1 THEN CALL FINWIN
430  PRINT AT(12,20) "NENTSCHIEDEN";
#    ASTE
435  CX=20:CY=13:TX=75:CPX

440  CALL AUCDONE


470 PROC MOGUY
500  MMOB PB+1,BC+8,YM(2)+7+32*(PB+1)
510  MOB SET PB+1,6+(BCAND1),1,0,0,0
520 END PROC

530 PROC SETBC
540  MMOB 5,BC,YM(2)+37:MMOB 6,BC,YM(2)+120:END PROC


#AUCTION IS OVER
# FIND WINNER
550 PROC FINWIN
560  PB=0:FORX=0TO3
570   IF AA(X) THEN PB=X
580  NEXT
590  PRINT AT(17,16) "EWINNER: "PN$(PB);

# DISPLAY HAPPY SPRITE
600  T1=TI:REPEAT

610  MOB SET PB+1,12,1,0,0,0
620  TS=TI:REPEAT:UNTIL TI-TS>10
630  MOB SET PB+1,13,1,0,0,0
640  TS=TI:REPEAT:UNTIL TI-TS>10

650  UNTIL TI-T1>180

#PRINT AT(BY+BH-2,BX+1) "TASTE";
#     RELATIVE TO "EBOT VON" FRAME
660  CY=-2:CX=25:TX=75:CPX

670 PROC AUCDONE
680  POKE198,0:DO NULL
690  MOBOFF1:MOBOFF2:MOBOFF3:MOBOFF4:MOBOFF5:MOBOFF6
699  CALL RTS




710  PROC OTOM

720  FSB

730  FR=28:SYSFM,FR:FRS
#28020  BX=1:BY=1:BW=38:BH=12:FRAME

#28030  GOTO 28200

#28030  PRINT AT(BY+1,BX+1)"EUJAHRSTOMBOLA:";
740  PRINT AT(BY+1,BX+17) DT%(2);
#28050  PRINT AT(BY+3,BX+1) "REIS:";
750  PRINT AT(BY+3,BX+8) "IN ILD";

# RAFFLE STANDING
760  MOB SET 1,8,1,0,0,0:MMOB 1,XM(2)+80,YM(2)+50
# BINGO 1
770  MMOB 2,XM(2)+95,YM(2)+50


780  T1=TI:REPEAT

790  MOB SET 2,9,1,0,0,0
800  TS=TI:REPEAT:UNTIL TI-TS>5
810  MOB SET 2,10,1,0,0,0
820  TS=TI:REPEAT:UNTIL TI-TS>5

830  UNTIL TI-T1>180

840  MOB SET 1,11,1,0,0,0

#PRINT AT(BY+9,BX+1) "ER REIS GEHT AN:";
850  CX=1:CY=9:TX=85:CPX
860  PRINT AT(BY+9,BY+20) PN$(CP);

#28150  CENTER AT(BY+11,BX+1) "- ERZLICHEN LCKWUNSCH ! -",36
870  CX=4:CY=11:TX=86:CPX

880  DO NULL
890  MOBOFF1:MOBOFF2:MOBOFF3

900  REM ASSIGN ARTWORK TO PLAYER

# SHOW LEADERBOARD
910  FR=30:SYSFM,FR:FRS
#28205  PRINT AT(BY+1,BX+1) "WISCHENSTAND:";
915  PRINT AT(BY+1,BX+15) DT%(2);

#28895  PRINT AT(BY+BH-2,BX+1) "ASTE";
920  CY=BH-2:CX=1:TX=75:CPX

930  PRINT AT(BY+5,BX+1) "VA:"D!PEEK($2D)",VE:"D!PEEK($37);

940  DO NULL
950  CALL RTS

960  END

# FRS JUST SETS THE FRAME VARIABLES
#  IN CASE THESE ARE NEEDED WITHOUT DRAWING THE FRAME
970 PROC FRS
980   BY=PEEK(FM+$1B):BX=PEEK(FM+$1C):BW=PEEK(FM+$1D):BH=PEEK(FM+$1E):END PROC

1010 PROC CPX
1020  SYSF3,CY+BY,CX+BX,TX:END PROC


1030 PROC FSB
1040  FILL 0,0,40,25,0,15:END PROC


60090 PROC RTS
60092  RV=-1
#62 LOAD"GAME"
60094  SYS MM+$21
60099 END


# ROUTINES TO RECOVER CHECK PROCEDURE TABLE
60105  POKE $C530,PEEK(1021)
#      FETCH
60110  SYS MM+12,256,$C400,$7E00:RETURN

# ROUTINE TO SAVE CHECK PROCEDURE TABLE
60200 PROC NYCHKSAV
60205  POKE 1021,PEEK($C530)
60210  SYS MM+9,256,$C400,$7E00
60230 END PROC

60300 MEMCLR D!PEEK($AE),VT-D!PEEK($AE):RETURN
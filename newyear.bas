# FRS JUST SETS THE FRAME VARIABLES
#  IN CASE THESE ARE NEEDED WITHOUT DRAWING THE FRAME
58190 PROC FRS

58192  F2=FA+FR+FR:F4=FA+D!PEEK(F2):BY=PEEK(F4):BX=PEEK(F4+1):BW=PEEK(F4+2):BH=PEEK(F4+3)

58199 END PROC

# INEN ASTEN MIT CHATTEN MALEN, DIE ARBEN SIND IN EINEM RRAY, DAMIT MAN
# DIE ARBKOMBINATIONEN UNTER ONTROLLE HAT.

# F2: THE OFFSET TO THE LAYOUT DATA
# F4: THE LAYOUT DATA
58200 PROC FRN

58201  FRS
58202  FRAME

58204  PROC NFRN
58205  F4=F4+4
58208  BA=PEEK(F4)
58215  IF BA=0 THEN END PROC

58225  IF BA=1 THEN CPR:CALL NFRN
58230  IF BA=2 THEN VPR:CALL NFRN
58235  IF BA=3 THEN VUS:F4=F4+5:GOTO 58208

58249 END PROC

# PRINT CONSTANT FROM FRAME DEFINITION
58250 PROC CPR

# TC:TEXT CONSTANTS START ADDRESS
# TX:TEXT INDEX OF CONSTANT
# TL:TEXT LENGTH
# TV:TEMP-VALUE FOR INDEX OFFSET
#58255  TX=PEEK(F4+3):Z=YO(BY+PEEK(F4+1))+BX+PEEK(F4+2)
58255  TX=PEEK(F4+3):CY=PEEK(F4+1):CX=PEEK(F4+2)
#58264  GOTO 58275

# PRINT CONSTANT WITH GIVEN INDEX
#  HERE, TX IS COMING FROM OUTSIDE
58265 PROC CPX
#58270  Z=YO(BY+CY)+BX+CX

58275  PT=TC+TX*3:TL=PEEK(PT):POKEMA,TL

# THIS LINE WRITES THE CONSTANT INTO MP$
58280  D!POKE$5A,TC+D!PEEK(PT+1):D!POKE$58,MP:POKE781,1:POKE782,TL:SYS $A3EC
#58280  MEMDEFTL,MP,D!PEEK(PT+1),0:MEMLOAD
58281  PRINT AT(BY+CY,BX+CX) MP$;

58289 END PROC

# PRINT VARIABLE VALUE TO FRAME COORDINATES
#  SAVES ABOUT 8 BYTES OVER REGULAR PRINTAT()
58300 PROC VPR

58305  CY=PEEK(F4+1):CX=PEEK(F4+2)
58310  TX=VX%(PEEK(F4+3)):CPX

58369 END PROC

# VARIABLE USE AT
58370 PROC VUS
58371  CY=PEEK(F4+1):CX=PEEK(F4+2):CF=PEEK(F4+3):VX=PEEK(F4+4)
58372  USE AT(BY+CY,BX+CX) CF$(CF),VX(VX)
58373 END PROC


58375 PROC FRAME
58380  INSERT BD$,BY,BX,BW,BH,FB:FILL BY+1,BX+1,BW-2,BH-2,32,1
58385  FCOL BY+BH,BX+1,BW,1,11:FCOL BY+1,BX+BW,1,BH,11
58390 END PROC

58530 PROC FSB
58531  FILL 0,0,40,25,0,15:END PROC

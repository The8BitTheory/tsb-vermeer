8350   PRINT AT(BY+1+4*X,BX+1) MID$(AA$,X+1,1);
8360  NEXT

8370  FORX=1TO4
8375   MMOB X,XM(2)+32,YM(2)+3+32*X
8380   MOB SET X,12,1,0,0,0
8385   PB%(X-1)=0
8390  NEXT
# COVERING THIS IN THE LOOP ABOVE
#8330  FORX=0TO3:PB%(X)=0:NEXT

8400  FR=33:FRN

8405  PRINT AT(0,38) "A";

8410  KEYGET I$

# SA:AUCTION TIMER. SHOULD VARY SPEED
# SV:TIMER SPEED. 20 JIFFIES PER DEFAULT
# CD:COUNT-DOWN. HOW MANY LINES THE TIMER BAR HAS
8415  SA=TI:CD=15:SV=20
8420  GET I$:I=PEEK(512)
#8420  SYS 49152

8421  PRINT AT(5,37) DUP(" ",15-CD)DUP("",CD);

8423  IF TI-SA<SV THEN 8439
#8424  SV=20
8425  CD=CD-1:IF CD<0 THEN 8450
8438  SA=TI

8439  IF LEN(I$)=0 THEN 8420
#8439  I=PEEK(780)
#8440  PRINT I;
#8445  GOTO 8420

#AA$=AUCTION ACTION KEYS (QWERNX)
8440  PB=PLACE(I$,AA$)-1
8442  IF PB<0 THEN 8420
8444  IF PB<4 THEN MOGUY:GOTO 8420
8446  IF PB=4 THEN 8370
8448  IF PB<>5 THEN 8420

#AUCTION IS OVER
# FIND WINNER
8450  PB=0:FORX=0TO3
8452   IF PB%(X)>PB%(PB) THEN PB=X
8454  NEXT
8455  PRINT AT(17,16) "EWINNER: "PN$(PB);

# DISPLAY HAPPY SPRITE
8460  T1=TI:REPEAT

8462  MOB SET PB+1,12,1,0,0,0
8464  TS=TI:REPEAT:UNTIL TI-TS>10
8466  MOB SET PB+1,13,1,0,0,0
8468  TS=TI:REPEAT:UNTIL TI-TS>10

8469  UNTIL TI-T1>180

#PRINT AT(BY+BH-2,BX+1) "TASTE";
8490  CY=BH-5:CX=30:TX=75:CPX

8500  POKE650,0:POKE198,0:DO NULL

8510  MOBOFF1:MOBOFF2:MOBOFF3:MOBOFF4

8520  CALL RTS

8530 END


8940 PROC MOGUY

8950  PB%(PB)=PB%(PB)+5:SA=TI
8960  MMOB PB+1,XM(2)+32+PB%(PB),YM(2)+3+32*(PB+1)
8970  MOB SET PB+1,6+(PB%(PB)AND1),1,0,0,0

8980 END PROC




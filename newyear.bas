# 8299 PROC AUCTION
# OR AUCTIONS, PLAYERS SHOULD HAVE THEIR CASH AND BANK AMOUNT AVAILABLE
# OR AUCTIONS IN EW ORK, PLAYERS MUST HAVE OLLARS IN THEIR ACCOUNT.
# UCTION OVERVIEW SHOULD ALSO SHOW THE CALLING PRICE AND WHAT THE PLAYER HAS
# AVAILABLE.
# UCTIONS START AUTOMATICALLY WHEN THE DATE HAS COME, BEFORE ANY PLAYER GETS
# TO THEIR TURN.
# EFORE THE AUCTION STARTS, PLAYERS CAN CHOSE TO OPT-IN OR OUT.
# F NO PLAYER PARTICIPATES, THE AUCTION ACTION SEQUENCE IS SKIPPED

8000 PROC AUCTION
8005  POKE 650,128

8310  FSB:FR=32:SYSFM,FR

8320  FR=31:SYSFM,FR:FRS

#     DRAW MAX BID BAR
8330  PRINT AT(BY+1,BX+14) DUP("",15);

8340  FORX=0TO3
8350   PRINT AT(BY+2+4*X,BX+1)PN$(X);
8360  NEXT

8370  FORX=1TO4
8375   MMOB X,XM(2)+88,YM(2)+7+32*X
8380   MOB SET X,12,1,0,0,0
8385   PB%(X-1)=0
8390  NEXT
# COVERING THIS IN THE LOOP ABOVE
#8330  FORX=0TO3:PB%(X)=0:NEXT

8400  FR=33:SYSFM,FR:FRS

8410  PRINT AT(0,38) "A";

8420  CX=10:CY=0:TX=75:CPX:KEYGET I$

# SA:AUCTION TIMER. SHOULD VARY SPEED
# SV:TIMER SPEED. 20 JIFFIES PER DEFAULT
# CD:COUNT-DOWN. HOW MANY LINES THE TIMER BAR HAS
8430  SA=TI:CD=15:SV=20
#     DRAW COUNTDOWN VISUALIZATION
#8440  PRINT AT(5,37) DUP(" ",15-CD)DUP("",CD);
8440  FCHR 5,37,1,15,95:FCOL 5,37,1,15,1

# THE WAY AUCTIONING WORKS
#  THE TOTAL TIME LIMIT IS 5 SECONDS AND THAT IS NEVER EXTENDED OR RESTORED.
#  PLAYERS PRESS A KEY TO BID
#  TIME IS CONSTANTLY RUNNING, EXCEPT A CHANGE TO THE HIGHEST BID IS MADE
#  SO, IF BIDS ARE INCREASING, TIME STANDS STILL
#  AS SOON AS NO BIDDING PROCESS IS MADE, THE CLOCK CONTINUES TO TICK
#  


# AIN=AUCTION INPUT
8450 PROC AIN
8460  SYS FM+9

8470  IF TI-SA<SV THEN CALL AIN
8480  SA=TI

8490  I=PEEK($FB)
8500  IF (IAND1)=1 THEN PB=0:MOGUY
8510  IF (IAND2)=2 THEN PB=1:MOGUY
8520  IF (IAND4)=4 THEN PB=2:MOGUY


#     KEY WAS PRESSED, DON'T ADVANCE COUNTDOWN(CD) AND CHECK FOR NEXT INPUT
8530  IF I>0 THEN CALL AIN

#     ADVANCE COUNTDOWN AND CHECK IF WE'RE DONE
8540  CD=CD-1:IF CD<0 THEN CALL FINWIN

#     NOT YET DONE, UPDATE COUNTOWN VISUALIZATION
#8550  PRINT AT(5,37) DUP(" ",15-CD)DUP("",CD);
8550  FCOL 5,37,1,15-CD,0:IF CD>0 THEN FCOL 5+15-CD,37,1,CD,1

#     CHECK FOR NEXT KEYPRESS
8560  CALL AIN

#AA$=AUCTION ACTION KEYS (QWERNX)
#8440  PB=PLACE(I$,AA$)-1
#8442  IF PB<0 THEN 8420
#8444  IF PB<4 THEN MOGUY:GOTO 8420
#8446  IF PB=4 THEN 8370
#8448  IF PB<>5 THEN 8420

#AUCTION IS OVER
# FIND WINNER
8570 PROC FINWIN
8580  PB=0:FORX=0TO3
8590   IF PB%(X)>PB%(PB) THEN PB=X
8600  NEXT
8610  PRINT AT(17,16) "EWINNER: "PN$(PB);

# DISPLAY HAPPY SPRITE
8620  T1=TI:REPEAT

8630  MOB SET PB+1,12,1,0,0,0
8640  TS=TI:REPEAT:UNTIL TI-TS>10
8650  MOB SET PB+1,13,1,0,0,0
8660  TS=TI:REPEAT:UNTIL TI-TS>10

8670  UNTIL TI-T1>180

#PRINT AT(BY+BH-2,BX+1) "TASTE";
#     RELATIVE TO "EBOT VON" FRAME
8680  CY=-2:CX=25:TX=75:CPX

8690  POKE650,0:POKE198,0:DO NULL

8700  MOBOFF1:MOBOFF2:MOBOFF3:MOBOFF4

8710  CALL RTS

8720 END


8730 PROC MOGUY
8740
8750  PB%(PB)=PB%(PB)+5
8760  MMOB PB+1,XM(2)+88+PB%(PB),YM(2)+7+32*(PB+1)
8770  MOB SET PB+1,6+(PB%(PB)AND1),1,0,0,0

8780 END PROC



28000  PROC OTOM

28010  FSB

28020  FR=28:SYSFM,FR:FRS
#28020  BX=1:BY=1:BW=38:BH=12:FRAME

#28030  GOTO 28200

#28030  PRINT AT(BY+1,BX+1)"EUJAHRSTOMBOLA:";
28040  PRINT AT(BY+1,BX+17) DT%(2);
#28050  PRINT AT(BY+3,BX+1) "REIS:";
28060  PRINT AT(BY+3,BX+8) "IN ILD";

# RAFFLE STANDING
28070  MOB SET 1,8,1,0,0,0:MMOB 1,XM(2)+80,YM(2)+50
# BINGO 1
28080  MMOB 2,XM(2)+95,YM(2)+50


28105  T1=TI:REPEAT

28110  MOB SET 2,9,1,0,0,0
28115  TS=TI:REPEAT:UNTIL TI-TS>5
28120  MOB SET 2,10,1,0,0,0
28125  TS=TI:REPEAT:UNTIL TI-TS>5

28130  UNTIL TI-T1>180

28135  MOB SET 1,11,1,0,0,0

#PRINT AT(BY+9,BX+1) "ER REIS GEHT AN:";
28140  CX=1:CY=9:TX=85:CPX
28145  PRINT AT(BY+9,BY+20) PN$(CP);

#28150  CENTER AT(BY+11,BX+1) "- ERZLICHEN LCKWUNSCH ! -",36
28150  CX=4:CY=11:TX=86:CPX

28180  DO NULL
28190  MOBOFF1:MOBOFF2:MOBOFF3

28195  REM ASSIGN ARTWORK TO PLAYER

# SHOW LEADERBOARD
28200  FR=30:SYSFM,FR:FRS
#28205  PRINT AT(BY+1,BX+1) "WISCHENSTAND:";
#28206  PRINT AT(BY+1,BX+15) DT%(2);

#28895  PRINT AT(BY+BH-2,BX+1) "ASTE";
28895  CY=BH-2:CX=1:TX=75:CPX

28896  PRINT AT(BY+5,BX+1) "VA:"D!PEEK($2D)",VE:"D!PEEK($37);

28898  DO NULL

28899  CALL RTS

28909  END






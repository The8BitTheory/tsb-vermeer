   341                          printConstant
   342                              ;pt=tc+tx*3:tl=peek(pt):pokema,tl
   343                              ;d!poke$5a,tc+d!peek(pt+1):d!poke$58,mp:poke781,1:poke782,tl:sys $a3ec
   344                              ; read constant index from parameter
   345  7dc2 2000e2                 jsr chkcommaint
   346  7dc5 8edfc5                 stx zeileanf
   347  7dc8 2000e2                 jsr chkcommaint
   348  7dcb 8ee0c5                 stx spalteanf

   352                          printIndexAt
   353  7dd2 20e17d                 jsr prepareForPrint
   354                          
   355                              ; read char into A and call BSOUT
   356                              ; for REU, f4 would be replaced with dedicated address $C64D, for example
   357                              ; indexed reading by x instead of y
   358  7dd5 a000                   ldy #0
   359  7dd7 b1fb               -   lda (memloc),y
   360  7dd9 20d2ff                 jsr bsout
   361  7ddc c8                     iny
   362  7ddd ca                     dex
   363  7dde d0f7                   bne -
   364                              
   365  7de0 60                     rts
   366                              
   367                          prepareForPrint
   368                          ; takes the value from .A (the text index) and multiplies by 3. store to f4
   369                          ;  that's where length and string pointer are stored
   370                          
   371  7de1 a200                   ldx #0
   372  7de3 8eb57e                 stx tempIndex+1
   373                              
   374                              ;load pointer to text constant into f4
   375                              ;pointer address = tempIndex*3
   376  7de6 a202                   ldx #2
   377  7de8 8db47e                 sta tempIndex
   378  7deb 18                 -   clc
   379  7dec 6db47e                 adc tempIndex
   380  7def 9003                   bcc +
   381  7df1 eeb57e                 inc tempIndex+1
   382  7df4 ca                 +   dex
   383  7df5 d0f4                   bne -
   384  7df7 8db47e                 sta tempIndex
   385                              
   386  7dfa 18                     clc
   387  7dfb 6daa7e                 adc tc        ; add offset to text-constants
   388  7dfe 8dfd00                 sta f4
   389                              
   390  7e01 adab7e                 lda tc+1
   391  7e04 6db57e                 adc tempIndex+1
   392  7e07 8dfe00                 sta f4+1
   393                              
   394  7e0a a903                   lda #3
   395  7e0c a200                   ldx #0
   396  7e0e 203a7e                 jsr .fromReuF4ToMemloc
   397                              
   398                              ; jump to constant print handling (same as for vpr)
   399  7e11 18                     clc         ;clear carry flag to indicate setting cursor position
   400  7e12 ace0c5                 ldy spalteanf   ;y-reg contains col
   401  7e15 aedfc5                 ldx zeileanf   ;x-reg contains row
   402  7e18 20f0ff                 jsr $fff0   ;set cursor position
   403                              
   404                              
   405                          ; stores the pointer to the text constant into f4
   406                          ;  length of the constant is stored to .X
   407                              ; get text data from constants
   408  7e1b a000                   ldy #0    
   409  7e1d b1fb                   lda (memloc),y    ; load length of text
   410  7e1f 48                     pha           ; store to stack
   411                              
   412  7e20 c8                     iny
   413  7e21 b1fb                   lda (memloc),y    ; pointer low-byte offset
   414  7e23 aa                     tax           ; store to X temporary
   415  7e24 c8                     iny
   416  7e25 b1fb                   lda (memloc),y    ; pointer high-byte offset
   417  7e27 a8                     tay           ; store to y temporary
   418                              
   419  7e28 18                     clc
   420  7e29 8a                     txa           ; get offset low-byte
   421  7e2a 6daa7e                 adc tc        ; add base-address low-byte
   422  7e2d 8dfd00                 sta f4        ; store as new offset low-byte 
   423                              
   424  7e30 98                     tya           ; get offset high-byte
   425  7e31 6dab7e                 adc tc+1      ; add base-address high-byte
   426  7e34 8dfe00                 sta f4+1      ; store as new offset high-byte
   427                          
   428  7e37 68                     pla           ; pull length from stack
   429                              ;tax           ; write to X
   430  7e38 a200                   ldx #0        ; high-byte of length=0
   431                              
   432                          ; f4 could be a reference to REU memory.
   433                          ; then we could copy the string to a dedicated RAM location at this point
   434                          ; f4 would receive the dedicated RAM location afterwards
   435                          ; the routine printIndexAt would then always just use a fixed read location

   306                          ; this reads 3 addresses (tc,fa,memloc) from parameters and stores them here for future use
   307                          setup
   308                              ; read memory type
   309  7d82 2000e2                 jsr chkcommaint
   310  7d85 8eac7e                 stx memtype
   311                              
   312                              ; read memloc. $c64d pretty much
   313  7d88 20fdae                 jsr chkcom
   314  7d8b 208aad                 jsr frmnum
   315  7d8e 20f7b7                 jsr getadr
   316  7d91 a514                   lda $14
   317  7d93 8dfb00                 sta memloc
   318  7d96 a515                   lda $15
   319  7d98 8dfc00                 sta memloc+1
   320                              
   321                              ; read text-constants offset. used to be $7a00 in main ram, but now needs to be REU/M65 bank offset
   322  7d9b 20fdae                 jsr chkcom
   323  7d9e 208aad                 jsr frmnum
   324  7da1 20f7b7                 jsr getadr

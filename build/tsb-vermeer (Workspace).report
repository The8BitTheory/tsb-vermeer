   555                          
   556                          
   557                          ; source: https://www.retro-programming.de/programming/nachschlagewerk/nice-to-know/reu-programmierung/
   558                          ;*******************************************************************************
   559                          ;*** REU-Register
   560                          ;*******************************************************************************
   561                          REUSTATUS           = $df00         ;Statusregister (nur lesen, wird dann gelöscht!)
   562                          REUCOMMAND          = $df01         ;Befehlsregister
   563                          REUC64RAM           = $df02         ;RAM-Adresse im C64 (LSB/MSB)
   564                          REURAM              = $df04         ;Speicher Adresse in der REU (LSB/MSB)
   565                          REUBANK             = $df06         ;Bank in der REU
   566                          REUBYTES            = $df07         ;Anzahl der betroffenen BYTES (LSB/MSB)
   567                          REUIRQMASK          = $df09         ;Interruptmaske
   568                          REUADRCONTROL       = $df0a         ;Adress-Kontroll-Register
   569                          
   570                          ;*******************************************************************************
   571                          ;*** REU-Befehle
   572                          ;*******************************************************************************
   573                           
   574                          ;*** Standardbefehle mit AUTOLOAD, ohne $ff00
   575                          REU_STASH_A__       = $fc           ;kopiere C64 -> REU
   576                          REU_FETCH_A__       = $fd           ;kopiere REU -> C64
   577                          REU_SWAP_A__        = $fe           ;Speicherbereich tauschen
   578                          REU_VERIFY_A__      = $ff           ;Speicherbereich vergleichen
   579                           
   580                          ;*** mit AUTOLOAD und mit $ff00
   581                          REU_STASH_A_F       = $ec           ;kopiere C64 -> REU
   582                          REU_FETCH_A_F       = $ed           ;kopiere REU -> C64
   583                          REU_SWAP_A_F        = $ee           ;Speicherbereich tauschen
   584                          REU_VERIFY_A_F      = $ef           ;Speicherbereich vergleichen
   585                           
   586                          ;*** ohne AUTOLOAD, ohne $ff00
   587                          REU_STASH____       = $dc           ;kopiere C64 -> REU
   588                          REU_FETCH____       = $dd           ;kopiere REU -> C64
   589                          REU_SWAP____        = $de           ;Speicherbereich tauschen
   590                          REU_VERIFY____      = $df           ;Speicherbereich vergleichen
   591                           
   592                          ;*** ohne AUTOLOAD, mit $ff00
   593                          REU_STASH___F       = $cc           ;kopiere C64 -> REU
   594                          REU_FETCH___F       = $cd           ;kopiere REU -> C64
   595                          REU_SWAP___F        = $ce           ;Speicherbereich tauschen
   596                          REU_VERIFY___F      = $cf           ;Speicherbereich vergleichen

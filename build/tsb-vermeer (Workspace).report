    24  79d4 8d00dc               sta $dc00       ; Spaltenregister schreiben
    25  79d7 2c00dc               bit $dc00       ; Dummy-Befehl: Warten, bis PA-Leitungen neuen Spannungspegel haben
    26  79da 2c00dc               bit $dc00       ; Nochmal etwas warten
    27                          
    28                          .loop
    29  79dd ad01dc               lda $dc01       ; Zeilenregister auslesen (PB)
    30  79e0 cd01dc               cmp $dc01       ; Entprellen:
    31  79e3 d0f8                 bne .loop       ; Warten bis PB stabil
    32  79e5 3dff79               and rows,x      ; Zeile ausmaskieren
    33                            
    34  79e8 d006                 bne .checkNext   ; nicht gedrückt. nächstes zeichen prüfen
    35                            
    36  79ea a5fc                 lda $fc
    37  79ec 05fb                 ora $fb
    38  79ee 85fb                 sta $fb
    39                          
    40                          .checkNext
    41  79f0 46fc                 lsr $fc  
    42  79f2 ca                   dex
    43  79f3 10dc                 bpl selectColumn
    44                          
    45  79f5 a9ff                 lda #%11111111
    46  79f7 8d00dc               sta $dc00
    47                          
    48  79fa 58                   cli             ; Interrupts wieder zulassen
    49  79fb 60                   rts             ; Rücksprung BASIC
    50                          
    51                          ;          return 01  pfhoch 66  pflinks71
    52  79fc febf7f             cols !byte %11111110, %10111111, %01111111
    53  79ff 024002             rows !byte %00000010, %01000000, %00000010


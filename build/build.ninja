################################################################################
# BUILD FILE
# generated file: DO NOT EDIT!
################################################################################

ninja_required_version = 1.3
toolkit = acme
machine = 
format = prg
basedir = d$:\c64\ver2\ver2
builddir = d$:\c64\ver2\ver2\build

project = frame.bin
config = d$:\c64\ver2\ver2\project-config.json
target = d$:\c64\ver2\ver2\build\frame.bin.prg
dbg_out = d$:\c64\ver2\ver2\build\frame.bin.report
python_exe = c$:\Users\martin\.vscode\extensions\rosc.vs64-2.6.2\resources\python\python.exe
java_exe = java
rc_exe = c$:\Users\martin\.vscode\extensions\rosc.vs64-2.6.2\tools\rc.py
rc_flags = --format acme --config "$config"
build_flags = 
asm_exe = d$:\Documents\c128\acme.exe

flags = --msvc --maxerrors 99 -DDEBUG=1 -f cbm --cpu 6510
includes = -I d$:\c64\ver2\ver2 -I d$:\c64\ver2\ver2 -I d$:\c64\ver2\ver2\build

rule res
    command = $python_exe $rc_exe $rc_flags -o $out $in

rule asm
    depfile = $out.d
    deps = gcc
    command = $asm_exe $flags $includes -r "$dbg_out" -o $out $in

build $target | $dbg_out : asm d$:\c64\ver2\ver2\frame.asm

build all: phony $target
default all

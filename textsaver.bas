1 REM WRITE TEXTS TO FILE

2 DEF FN HB(ZZ)=DEC(LEFT$(HEX$(ZZ),2))
3 DEF FN LB(ZZ)=DEC(RIGHT$(HEX$(ZZ),2))

11 PO=DEC("1300"):PA=PO

15 GRAPHIC0:PRINT CHR$(14)

# WRITE STRING LENGTHS AND GET THE COUNT
30 READ A$:IF A$="-1" THEN GOTO 70
40 PRINT C":"A$:C=C+1
50 POKE PA,LEN(A$):PA=PA+3
60 GOTO 30

70 PRINT "STRING TABLE FROM "HEX$(PO)"-"HEX$(PA):PA=PA+3

# SCREENCODE CONVERSION IS DONE BY JUST PRINTING AND THEN PEEK FROM THE SCREEN
100 P1=PA-PO
110 RESTORE
120 FOR X=0 TO C-1
130  READ A$:PRINT A$
135  POKE PO+X*3+1,FNLB(P1)
136  POKE PO+X*3+2,FNHB(P1)
140  FOR SP=1 TO LEN(A$)
#150   POKE P1+PO,PEEK(1023+SP)
150   POKE P1+PO,ASC(MID$(A$,SP,1))
155   P1=P1+1
160  NEXT
170 NEXT

180 PRINT "STRING VALUES TO "HEX$(P1+PO)

185 PRINT "INSERT DATADISK":GETKEY I$
190 BSAVE"@TEXTCONSTS",B0,P(PO) TO P(P1+PO)

999 PRINT CHR$(142);:END



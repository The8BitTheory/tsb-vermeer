# ALL THE RESOURCE FILES WOULD BE LOADED TO $0400
# READ FIRST OFFSET, COPY FROM THAT TO THE VALUE IN $AE/$AF
# NEXT RESOURCE FILE IS LOADED TO $0400+END OF PREV RESOURCE
# DIRECTORIES ARE LEFT IN RAM, VALUES ARE COPIED TO REU
# FA: INITIAL ADDRESS
# NL: NEXT ADDRESS
# RA: REU ADDRESS
100 PROC COPYTOREU
#    GET FIRST OFFSET ADDRESS
110  RO(A-4)=NL:O1=D!PEEK(NL):L1=D!PEEK($AE)-O1

#    COPY VALUES TO REU. L1 BYTES FROM OFFSET TO REU TARGET ADDRESS PLUS OFFSET THERE
120  MEMDEF L1,FA+O1,RA+RO(A-4)-FA,0:MEMSAVE

#    NL IS THE LOAD TARGET ADDRESS FOR THE NEXT RESOURCE FILE
#    WE ALSO NEED OFFSETS FOR THE NEXT REU TARGET ADDRESS
130  NL=NL+O1
199 END PROC

# ONCE THE PROJECT IS DONE, ALL THIS CAN BE PRE-BAKED INTO A SINGLE RESOURCE FILE